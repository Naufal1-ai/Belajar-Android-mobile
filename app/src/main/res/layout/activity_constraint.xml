<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.layout.ConstraintActivity">

    <TextView
        android:id="@+id/biodata"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="BIODATA"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/nama"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:layout_marginStart="20dp"
        android:text="Nama"
        app:layout_constraintTop_toBottomOf="@id/biodata"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/isinama"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:layout_marginStart="10dp"
        android:text=": Zikra Revanzha"
        app:layout_constraintTop_toBottomOf="@id/biodata"
        app:layout_constraintStart_toEndOf="@id/nama" />

    <TextView
        android:id="@+id/nim"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginStart="20dp"
        android:text="Nim"
        app:layout_constraintTop_toBottomOf="@id/nama"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/isinim"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:text=": 2411082025"
        app:layout_constraintStart_toEndOf="@id/nim"
        app:layout_constraintTop_toBottomOf="@id/isinama" />

    <TextView
        android:id="@+id/email"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginStart="20dp"
        android:text="Email"
        app:layout_constraintTop_toBottomOf="@id/nim"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/isiemail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginStart="10dp"
        android:text=": zikrarevanzha@gmail.com"
        app:layout_constraintTop_toBottomOf="@id/isinim"
        app:layout_constraintStart_toEndOf="@id/email" />

</androidx.constraintlayout.widget.ConstraintLayout>